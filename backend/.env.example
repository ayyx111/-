# ============ 应用配置 ============
# 运行环境 development|production
NODE_ENV=development
# 服务端口
PORT=3000
# 应用名称
APP_NAME=campus-fish-backend

# ============ 数据库配置 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=campus_fish
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE=10000

# ============ Redis配置 ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=campus_fish:

# ============ JWT配置 ============
# JWT密钥(生产环境务必修改)
JWT_SECRET=campus_fish_jwt_secret_change_me_2026
JWT_REFRESH_SECRET=campus_fish_jwt_refresh_secret_change_me_2026
# AccessToken有效期(秒) 默认2小时
JWT_ACCESS_EXPIRES=7200
# RefreshToken有效期(秒) 默认7天
JWT_REFRESH_EXPIRES=604800
# JWT签发者
JWT_ISSUER=campus-fish

# ============ 文件上传配置 ============
# 上传根目录
UPLOAD_DIR=uploads
# 单文件大小限制(字节) 默认5MB
UPLOAD_MAX_SIZE=5242880
# 允许的MIME类型(逗号分隔)
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
# 静态资源访问前缀
UPLOAD_URL_PREFIX=/uploads

# ============ 限流配置 ============
# 登录限流 每分钟最大次数
RATE_LIMIT_LOGIN_MAX=5
# 通用限流 每分钟最大次数
RATE_LIMIT_GENERAL_MAX=100

# ============ 初始化配置 ============
# 是否自动同步表结构(开发环境可开启)
DB_SYNC=false
# 默认管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============ AI 服务地址 ============
# AI 服务地址(本地部署填 http://127.0.0.1:8000)
AI_SERVICE_URL=http://127.0.0.1:8000

# ============ 跨域配置 ============
# 允许的前端源(逗号分隔)
CORS_ORIGIN=*
