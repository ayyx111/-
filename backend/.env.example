# ============ 应用配置 ============
# 运行环境 development|production
NODE_ENV=development
# 服务端口
PORT=3000
# 应用名称
APP_NAME=campus-fish-backend

# ============ 数据库配置 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=campus_fish
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE=10000

# ============ Redis配置 ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=campus_fish:

# ============ JWT配置 ============
# JWT密钥(生产环境务必修改)
JWT_SECRET=campus_fish_jwt_secret_change_me_2026
JWT_REFRESH_SECRET=campus_fish_jwt_refresh_secret_change_me_2026
# AccessToken有效期(秒) 默认2小时
JWT_ACCESS_EXPIRES=7200
# RefreshToken有效期(秒) 默认7天
JWT_REFRESH_EXPIRES=604800
# JWT签发者
JWT_ISSUER=campus-fish

# ============ 文件上传配置 ============
# 上传根目录
UPLOAD_DIR=uploads
# 单文件大小限制(字节) 默认5MB
UPLOAD_MAX_SIZE=5242880
# 允许的MIME类型(逗号分隔)
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif
# 静态资源访问前缀
UPLOAD_URL_PREFIX=/uploads
# 公网访问基础URL(生产环境必填,如 https://resplendent-caring-production-ebd2.up.railway.app)
UPLOAD_PUBLIC_BASE_URL=

# ============ Cloudinary 云存储配置(推荐,避免 Railway 容器重启丢失图片) ============
# 方式 A: 一键配置(推荐) - 在 Cloudinary Console → API Keys 页面复制环境变量
# 将 cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME> 粘贴到下方
# CLOUDINARY_URL=cloudinary://555369579447277:YOUR_API_SECRET@mkh6segx

# 方式 B: 分离配置
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# 上传到 Cloudinary 的文件夹前缀(用于区分项目)
CLOUDINARY_FOLDER=campus-fish

# ============ 限流配置 ============
# 登录限流 每分钟最大次数
RATE_LIMIT_LOGIN_MAX=5
# 通用限流 每分钟最大次数
RATE_LIMIT_GENERAL_MAX=100

# ============ 初始化配置 ============
# 是否自动同步表结构(开发环境可开启)
DB_SYNC=false
# 默认管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============ AI 服务地址 ============
# AI 服务地址(本地部署填 http://127.0.0.1:8000)
AI_SERVICE_URL=http://127.0.0.1:8000

# ============ 跨域配置 ============
# 允许的前端源(逗号分隔)
CORS_ORIGIN=*

# ============ 邮件配置 ============
# 方式 A(推荐): Resend HTTP API — 不受 SMTP 端口限制,Railway 可用
# 注册 resend.com → API Keys → 创建 → 复制 re_ 开头的 Key
# 免费额度: 100 封/天,足够校园项目使用
RESEND_API_KEY=
# 发件人地址(默认使用 Resend 测试域名)
RESEND_FROM=onboarding@resend.dev

# 方式 B(本地开发): SMTP — 配置后优先级低于 Resend
#   QQ邮箱:  SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_USER=你的QQ邮箱  SMTP_PASS=授权码
#   163邮箱: SMTP_HOST=smtp.163.com SMTP_PORT=465  SMTP_USER=你的163邮箱 SMTP_PASS=授权码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=校园咸鱼
