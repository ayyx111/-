# ============ AI 服务本地配置模板 ============
# 使用方法:
#   1. 复制本文件为 .env (注意:不要带 .example 后缀)
#   2. 按下方说明填入自己的值
#   3. .env 不会被提交到 git,可放心填入敏感信息
#   PowerShell 复制命令: Copy-Item .env.example .env

# ============ MySQL 数据库配置 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 改成你本地 MySQL 的 root 密码
DB_PASSWORD=your_mysql_password
DB_NAME=campus_fish

# ============ Redis 配置 ============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 若 Redis 没设密码就留空
REDIS_PASSWORD=

# ============ 服务端口 ============
APP_PORT=8000
HOT_CACHE_TTL=300

# ============ LLM 大模型配置(智谱 GLM-4-Flash,永久免费) ============
# 1. 注册智谱开放平台账号: https://open.bigmodel.cn/
# 2. 进入「API Keys」页面创建一个 API Key
# 3. 把生成的 Key 粘贴到下方(格式为 xxxxxxxxxx.yyyyyyyyyy)
LLM_API_KEY=your_zhipu_api_key_here
# 智谱 API 基础地址(兼容 OpenAI 协议,一般不用改)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名称(GLM-4-Flash 永久免费,一般不用改)
LLM_MODEL=glm-4-flash
# 温度参数(0-1,越低越确定,一般不用改)
LLM_TEMPERATURE=0.3
# 超时(秒)
LLM_TIMEOUT=15
