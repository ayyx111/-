# ============ 云服务器部署环境变量 ============
# 复制此文件为 .env 并填写真实值

# 域名(用于生成图片 URL 和 SSL 证书)
DOMAIN=https://campusfish.qd.je

# MySQL 数据库密码(请修改为强密码)
DB_ROOT_PASSWORD=CampusFish@2026

# JWT 密钥(请修改为随机字符串)
JWT_SECRET=your_random_jwt_secret_here
JWT_REFRESH_SECRET=your_random_refresh_secret_here

# 管理员密码
ADMIN_PASSWORD=admin123

# 邮件发送(Resend API)
# 在 Resend 控制台获取 API Key,格式: re_xxxxxxxx
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=campus-fish@campusfish.qd.je
